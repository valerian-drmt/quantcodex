---
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/site';
import { notebooks } from '../../lib/content';

const domains = [...new Set(notebooks.map((n) => n.domain))].sort();
---
<Base title="Notebooks" active="notebooks">
  <div class="container page">
    <h1 class="page-title">Research notebooks</h1>

    <div class="list-layout" data-table data-sort="num" data-dir="-1" data-per="10">
      <aside class="glass filters" aria-label="Filters">
        <div>
          <h2>Domain</h2>
          <div class="facet">
            {domains.map((d) => (
              <button type="button" data-facet="domain" data-value={d} aria-pressed="false">
                <span>{d}</span><span class="count">{notebooks.filter((n) => n.domain === d).length}</span>
              </button>
            ))}
          </div>
        </div>
        <button type="button" class="link-btn" data-reset>Clear filters</button>
      </aside>

      <section class="glass table-card">
        <div class="search">
          <label>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
            <span class="sr-only">Search notebooks</span>
            <input type="search" placeholder="Search a term" data-search />
          </label>
        </div>
        <div class="table-scroll">
          <div class="table">
            <div class="trow head notebooks-grid">
              <button type="button" data-sort="num" data-label="No.">No.</button>
              <button type="button" data-sort="title" data-label="Notebook">Notebook</button>
              <span>Domain</span>
              <span>Updated</span>
            </div>
            <div data-rows>
              {notebooks.map((n) => (
                <a
                  class="trow notebooks-grid"
                  data-row
                  href={url(`notebooks/${n.slug}/`)}
                  data-num={n.num}
                  data-title={n.title}
                  data-domain={n.domain}
                  data-search={`${n.num} ${n.title} ${n.summary} ${n.domain} ${n.sections.map((s) => s.title).join(' ')}`.toLowerCase()}
                >
                  <span class="num">{n.num}</span>
                  <span class="title"><strong>{n.title}</strong><small>{n.summary}</small></span>
                  <span class="cell">{n.domain}</span>
                  <span class="date">{n.updated}</span>
                </a>
              ))}
            </div>
            <p class="empty" data-empty hidden>No notebook matches this search.</p>
          </div>
        </div>
        <nav class="pager" aria-label="Pagination">
          <div class="left"><span class="info" data-info></span></div>
          <div class="pages" data-pages></div>
        </nav>
      </section>
    </div>
  </div>
</Base>

<script>
  import { initTable } from '../../scripts/table';
  document.querySelectorAll<HTMLElement>('[data-table]').forEach(initTable);
</script>
